<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet audit 警告(相依套件的已知弱點通報)不升級為錯誤:
         套件相依刻意寫最低版本(8.0.0),由消費端 unify 到已修補的版本。 -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- 套件中繼資料:只套用到 src/ 底下 -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <Authors>許彧銘 (Cornhsu)</Authors>
    <Company>Cornhsu</Company>
    <Copyright>Copyright © 許彧銘</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- 版本的唯一真相源是 git tag:release.yml 用 -p:Version= 覆寫這格。
         這裡不能留空——留空會退回 MSBuild 預設的 1.0.0,那是個「看起來合理的真版本號」,
         從原始碼建置出來的組件會自稱 1.0.0 而沒有人會懷疑它(已發佈的是 1.1.0 之後)。
         0.0.0-dev 是刻意選的:錯得明顯勝過錯得像真的。
         ⚠ 本機 `dotnet pack` 出來的 0.0.0-dev 若裝進一個同時引用正式版的專案,
         NuGet 會 unify 到正式版,你的本機改動會被靜默忽略——用 ProjectReference 測本機修改。 -->
    <Version>0.0.0-dev</Version>
    <!-- ProjectUrl 是「專案首頁」,RepositoryUrl 是「原始碼在哪」——兩者本來就不是同一件事。
         原本兩格填同一個 GitHub 網址,等於白白浪費一格;首頁指向作品頁,說明更完整,
         也讓 nuget.org、GitHub 與 cornhsu.com 被認成同一個專案。 -->
    <PackageProjectUrl>https://cornhsu.com/cornhsu-labeling</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HSU-YU-MING/cornhsu-labeling</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>efcore;entity-framework-core;labeling;labelling;tagging;tags;polymorphic;taxonomy</PackageTags>

    <!-- 可除錯性:讓使用者能 step-in 進你的原始碼 -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- 可重現建置 -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon.png"  Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>
</Project>
